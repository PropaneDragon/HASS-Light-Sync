<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:captures="using:LightSync.UI.ViewModels.Captures"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="using:LightSync.UI.Containers"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LightSync.UI.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LightSync.UI.Views.Pages.SourcesPageView"
             x:DataType="vm:SourcesPageViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignDataConfiguration.SourcesPage" />
    </Design.DataContext>

    <Border Padding="{DynamicResource PagePadding}">
        <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource SpacingXL}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Border Grid.Column="0">
                    <StackPanel Spacing="{DynamicResource SpacingS}">
                        <TextBlock Classes="heading" Text="Sources" />
                        <TextBlock Classes="label" Text="Details" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingS}" VerticalAlignment="Top">
                        <Button><i:Icon Value="fa7-rotate" /></Button>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1">
                <Grid ColumnSpacing="{DynamicResource SpacingL}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="280" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                
                    <Border Grid.Column="0">
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{DynamicResource SpacingL}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="captures:CaptureInfoViewModel">
                                    <Border Classes="card compact">
                                        <TextBlock Text="{Binding Name}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Grid.Column="1" Classes="card" Padding="0" ClipToBounds="True" VerticalAlignment="Stretch">
                        <Image Source="{Binding PreviewBitmap}" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
