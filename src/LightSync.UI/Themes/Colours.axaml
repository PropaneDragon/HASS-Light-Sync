<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <StackPanel Orientation="Horizontal">
            <ThemeVariantScope RequestedThemeVariant="Dark">
                <Border Padding="20" Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
                    <WrapPanel Orientation="Vertical" Height="448">
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColor}"/></Border.Background></Border><TextBlock Text="SystemAccentColor" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/></Border.Background></Border><TextBlock Text="SystemAccentColorLight1" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorLight2}"/></Border.Background></Border><TextBlock Text="SystemAccentColorLight2" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorLight3}"/></Border.Background></Border><TextBlock Text="SystemAccentColorLight3" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorDark1}"/></Border.Background></Border><TextBlock Text="SystemAccentColorDark1" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorDark2}"/></Border.Background></Border><TextBlock Text="SystemAccentColorDark2" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorDark3}"/></Border.Background></Border><TextBlock Text="SystemAccentColorDark3" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource BackgroundColour}"/></Border.Background></Border><TextBlock Text="BackgroundColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource ScrimColour}"/></Border.Background></Border><TextBlock Text="ScrimColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SurfaceColour}"/></Border.Background></Border><TextBlock Text="SurfaceColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SurfaceRaisedColour}"/></Border.Background></Border><TextBlock Text="SurfaceRaisedColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SurfaceHoverColour}"/></Border.Background></Border><TextBlock Text="SurfaceHoverColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SurfacePressedColour}"/></Border.Background></Border><TextBlock Text="SurfacePressedColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource InputBackgroundColour}"/></Border.Background></Border><TextBlock Text="InputBackgroundColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource OutlineColour}"/></Border.Background></Border><TextBlock Text="OutlineColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource OutlineStrongColour}"/></Border.Background></Border><TextBlock Text="OutlineStrongColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextColour}"/></Border.Background></Border><TextBlock Text="TextColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextMutedColour}"/></Border.Background></Border><TextBlock Text="TextMutedColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextDisabledColour}"/></Border.Background></Border><TextBlock Text="TextDisabledColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextOnAccentColour}"/></Border.Background></Border><TextBlock Text="TextOnAccentColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextOnDangerColour}"/></Border.Background></Border><TextBlock Text="TextOnDangerColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SuccessColour}"/></Border.Background></Border><TextBlock Text="SuccessColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource WarningColour}"/></Border.Background></Border><TextBlock Text="WarningColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource DangerColour}"/></Border.Background></Border><TextBlock Text="DangerColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                    </WrapPanel>
                </Border>
            </ThemeVariantScope>
            <ThemeVariantScope RequestedThemeVariant="Light">
                <Border Padding="20" Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
                    <WrapPanel Orientation="Vertical" Height="448">
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColor}"/></Border.Background></Border><TextBlock Text="SystemAccentColor" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/></Border.Background></Border><TextBlock Text="SystemAccentColorLight1" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorLight2}"/></Border.Background></Border><TextBlock Text="SystemAccentColorLight2" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorLight3}"/></Border.Background></Border><TextBlock Text="SystemAccentColorLight3" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorDark1}"/></Border.Background></Border><TextBlock Text="SystemAccentColorDark1" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorDark2}"/></Border.Background></Border><TextBlock Text="SystemAccentColorDark2" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SystemAccentColorDark3}"/></Border.Background></Border><TextBlock Text="SystemAccentColorDark3" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource BackgroundColour}"/></Border.Background></Border><TextBlock Text="BackgroundColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource ScrimColour}"/></Border.Background></Border><TextBlock Text="ScrimColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SurfaceColour}"/></Border.Background></Border><TextBlock Text="SurfaceColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SurfaceRaisedColour}"/></Border.Background></Border><TextBlock Text="SurfaceRaisedColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SurfaceHoverColour}"/></Border.Background></Border><TextBlock Text="SurfaceHoverColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SurfacePressedColour}"/></Border.Background></Border><TextBlock Text="SurfacePressedColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource InputBackgroundColour}"/></Border.Background></Border><TextBlock Text="InputBackgroundColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource OutlineColour}"/></Border.Background></Border><TextBlock Text="OutlineColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource OutlineStrongColour}"/></Border.Background></Border><TextBlock Text="OutlineStrongColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextColour}"/></Border.Background></Border><TextBlock Text="TextColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextMutedColour}"/></Border.Background></Border><TextBlock Text="TextMutedColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextDisabledColour}"/></Border.Background></Border><TextBlock Text="TextDisabledColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextOnAccentColour}"/></Border.Background></Border><TextBlock Text="TextOnAccentColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource TextOnDangerColour}"/></Border.Background></Border><TextBlock Text="TextOnDangerColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource SuccessColour}"/></Border.Background></Border><TextBlock Text="SuccessColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource WarningColour}"/></Border.Background></Border><TextBlock Text="WarningColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}"><Border.Background><SolidColorBrush Color="{DynamicResource DangerColour}"/></Border.Background></Border><TextBlock Text="DangerColour" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                    </WrapPanel>
                </Border>
            </ThemeVariantScope>
        </StackPanel>
    </Design.PreviewWith>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FFB84D</Color>
            <Color x:Key="SystemAccentColorLight1">#FFC670</Color>
            <Color x:Key="SystemAccentColorLight2">#FFD494</Color>
            <Color x:Key="SystemAccentColorLight3">#FFE2B8</Color>
            <Color x:Key="SystemAccentColorDark1">#E8A13F</Color>
            <Color x:Key="SystemAccentColorDark2">#D18A2A</Color>
            <Color x:Key="SystemAccentColorDark3">#B87518</Color>

            <Color x:Key="BackgroundColour">#14161B</Color>
            <Color x:Key="ScrimColour">#000</Color>
            <Color x:Key="SurfaceColour">#1C1F26</Color>
            <Color x:Key="SurfaceRaisedColour">#232732</Color>
            <Color x:Key="SurfaceHoverColour">#2B303C</Color>
            <Color x:Key="SurfacePressedColour">#323847</Color>
            <Color x:Key="InputBackgroundColour">#14161B</Color>
            <Color x:Key="OutlineColour">#2A2E38</Color>
            <Color x:Key="OutlineStrongColour">#3A4150</Color>
            <Color x:Key="TextColour">#E8EAF0</Color>
            <Color x:Key="TextMutedColour">#9AA1B0</Color>
            <Color x:Key="TextDisabledColour">#6B7280</Color>
            <Color x:Key="TextOnAccentColour">#1A1405</Color>
            <Color x:Key="TextOnDangerColour">#1A0A08</Color>
            <Color x:Key="SuccessColour">#6EE7A8</Color>
            <Color x:Key="WarningColour">#FFB84D</Color>
            <Color x:Key="DangerColour">#FF7A70</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#FFB84D</Color>
            <Color x:Key="SystemAccentColorLight1">#FFC670</Color>
            <Color x:Key="SystemAccentColorLight2">#FFD494</Color>
            <Color x:Key="SystemAccentColorLight3">#FFE2B8</Color>
            <Color x:Key="SystemAccentColorDark1">#E8A13F</Color>
            <Color x:Key="SystemAccentColorDark2">#D18A2A</Color>
            <Color x:Key="SystemAccentColorDark3">#B87518</Color>

            <Color x:Key="BackgroundColour">#F4F5F8</Color>
            <Color x:Key="ScrimColour">#000</Color>
            <Color x:Key="SurfaceColour">#FFFFFF</Color>
            <Color x:Key="SurfaceRaisedColour">#EEF0F5</Color>
            <Color x:Key="SurfaceHoverColour">#E4E7EE</Color>
            <Color x:Key="SurfacePressedColour">#D8DCE6</Color>
            <Color x:Key="InputBackgroundColour">#FFFFFF</Color>
            <Color x:Key="OutlineColour">#DADEE7</Color>
            <Color x:Key="OutlineStrongColour">#BCC3D1</Color>
            <Color x:Key="TextColour">#14161B</Color>
            <Color x:Key="TextMutedColour">#5A6272</Color>
            <Color x:Key="TextDisabledColour">#8A91A0</Color>
            <Color x:Key="TextOnAccentColour">#1A1405</Color>
            <Color x:Key="TextOnDangerColour">#FFFFFF</Color>
            <Color x:Key="SuccessColour">#0E7A4B</Color>
            <Color x:Key="WarningColour">#8A5A00</Color>
            <Color x:Key="DangerColour">#C0392B</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>