<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <StackPanel Orientation="Horizontal">
            <ThemeVariantScope RequestedThemeVariant="Dark">
                <Border Padding="20" Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
                    <WrapPanel Orientation="Vertical" Height="448">
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource BackgroundBrush}"/><TextBlock Text="BackgroundBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource ScrimBrush}"/><TextBlock Text="ScrimBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TrackBrush}"/><TextBlock Text="TrackBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SurfaceBrush}"/><TextBlock Text="SurfaceBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SurfaceRaisedBrush}"/><TextBlock Text="SurfaceRaisedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SurfaceHoverBrush}"/><TextBlock Text="SurfaceHoverBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SurfacePressedBrush}"/><TextBlock Text="SurfacePressedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource InputBackgroundBrush}"/><TextBlock Text="InputBackgroundBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource OutlineBrush}"/><TextBlock Text="OutlineBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource OutlineStrongBrush}"/><TextBlock Text="OutlineStrongBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextBrush}"/><TextBlock Text="TextBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextMutedBrush}"/><TextBlock Text="TextMutedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextDisabledBrush}"/><TextBlock Text="TextDisabledBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextOnAccentBrush}"/><TextBlock Text="TextOnAccentBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextOnDangerBrush}"/><TextBlock Text="TextOnDangerBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource DangerSubtleBrush}"/><TextBlock Text="DangerSubtleBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource DangerSubtlePressedBrush}"/><TextBlock Text="DangerSubtlePressedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource AccentBrush}"/><TextBlock Text="AccentBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource AccentHoverBrush}"/><TextBlock Text="AccentHoverBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource AccentPressedBrush}"/><TextBlock Text="AccentPressedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SuccessBrush}"/><TextBlock Text="SuccessBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource WarningBrush}"/><TextBlock Text="WarningBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource DangerBrush}"/><TextBlock Text="DangerBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource AccentSubtleBrush}"/><TextBlock Text="AccentSubtleBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SuccessSubtleBrush}"/><TextBlock Text="SuccessSubtleBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource WarningSubtleBrush}"/><TextBlock Text="WarningSubtleBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                    </WrapPanel>
                </Border>
            </ThemeVariantScope>
            <ThemeVariantScope RequestedThemeVariant="Light">
                <Border Padding="20" Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
                    <WrapPanel Orientation="Vertical" Height="448">
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource BackgroundBrush}"/><TextBlock Text="BackgroundBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource ScrimBrush}"/><TextBlock Text="ScrimBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TrackBrush}"/><TextBlock Text="TrackBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SurfaceBrush}"/><TextBlock Text="SurfaceBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SurfaceRaisedBrush}"/><TextBlock Text="SurfaceRaisedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SurfaceHoverBrush}"/><TextBlock Text="SurfaceHoverBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SurfacePressedBrush}"/><TextBlock Text="SurfacePressedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource InputBackgroundBrush}"/><TextBlock Text="InputBackgroundBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource OutlineBrush}"/><TextBlock Text="OutlineBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource OutlineStrongBrush}"/><TextBlock Text="OutlineStrongBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextBrush}"/><TextBlock Text="TextBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextMutedBrush}"/><TextBlock Text="TextMutedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextDisabledBrush}"/><TextBlock Text="TextDisabledBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextOnAccentBrush}"/><TextBlock Text="TextOnAccentBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource TextOnDangerBrush}"/><TextBlock Text="TextOnDangerBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource DangerSubtleBrush}"/><TextBlock Text="DangerSubtleBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource DangerSubtlePressedBrush}"/><TextBlock Text="DangerSubtlePressedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource AccentBrush}"/><TextBlock Text="AccentBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource AccentHoverBrush}"/><TextBlock Text="AccentHoverBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource AccentPressedBrush}"/><TextBlock Text="AccentPressedBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SuccessBrush}"/><TextBlock Text="SuccessBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource WarningBrush}"/><TextBlock Text="WarningBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource DangerBrush}"/><TextBlock Text="DangerBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource AccentSubtleBrush}"/><TextBlock Text="AccentSubtleBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource SuccessSubtleBrush}"/><TextBlock Text="SuccessSubtleBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="230"><Border Width="24" Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OutlineStrongBrush}" Background="{DynamicResource WarningSubtleBrush}"/><TextBlock Text="WarningSubtleBrush" Classes="caption" VerticalAlignment="Center"/></StackPanel>
                    </WrapPanel>
                </Border>
            </ThemeVariantScope>
        </StackPanel>
    </Design.PreviewWith>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColour}"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="{DynamicResource ScrimColour}" Opacity="0.7"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{DynamicResource OutlineColour}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColour}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColour}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColour}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{DynamicResource SurfacePressedColour}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource InputBackgroundColour}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{DynamicResource OutlineColour}"/>
    <SolidColorBrush x:Key="OutlineStrongBrush" Color="{DynamicResource OutlineStrongColour}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColour}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColour}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColour}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource TextOnAccentColour}"/>
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="{DynamicResource TextOnDangerColour}"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{DynamicResource DangerColour}" Opacity="0.12"/>
    <SolidColorBrush x:Key="DangerSubtlePressedBrush" Color="{DynamicResource DangerColour}" Opacity="0.2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource SystemAccentColorLight1}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource SystemAccentColorDark1}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColour}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColour}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColour}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{DynamicResource SuccessColour}" Opacity="0.12"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{DynamicResource WarningColour}" Opacity="0.12"/>
</ResourceDictionary>