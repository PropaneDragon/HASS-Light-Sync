<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="AppCheckBoxTheme" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Style Selector="^ /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="^:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </ControlTheme>

</ResourceDictionary>
