<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <StackPanel Orientation="Horizontal">
            <ThemeVariantScope RequestedThemeVariant="Dark">
                <Border Padding="20" Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
                    <StackPanel Spacing="12" Width="260">
                        <ComboBox Theme="{DynamicResource AppComboBoxTheme}" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem>First option</ComboBoxItem>
                            <ComboBoxItem>Second option</ComboBoxItem>
                        </ComboBox>
                        <ComboBox Theme="{DynamicResource AppComboBoxTheme}" IsEnabled="False" PlaceholderText="Disabled" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </ThemeVariantScope>
            <ThemeVariantScope RequestedThemeVariant="Light">
                <Border Padding="20" Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
                    <StackPanel Spacing="12" Width="260">
                        <ComboBox Theme="{DynamicResource AppComboBoxTheme}" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem>First option</ComboBoxItem>
                            <ComboBoxItem>Second option</ComboBoxItem>
                        </ComboBox>
                        <ComboBox Theme="{DynamicResource AppComboBoxTheme}" IsEnabled="False" PlaceholderText="Disabled" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </ThemeVariantScope>
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme x:Key="AppComboBoxTheme" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}"/>
        <Setter Property="Padding" Value="{DynamicResource InputPadding}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style Selector="^:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}"/>
        </Style>
        <Style Selector="^:focus /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </ControlTheme>

</ResourceDictionary>
