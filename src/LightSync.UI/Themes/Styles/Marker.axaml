<!-- <Border Classes="marker" Classes.selected="{Binding IsSelected}">   outer: transparent / accent ring
        <Border Classes="dot"><TextBlock Text="{Binding Number}"/></Border> inner: the numbered disc
      </Border>
     Border.handle is the grip on the capture-radius ring. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <StackPanel Orientation="Horizontal">
            <ThemeVariantScope RequestedThemeVariant="Dark">
                <Border Padding="20" Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
                    <Border Padding="24" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#3A1F5C" Offset="0"/><GradientStop Color="#1F6FB5" Offset="0.55"/><GradientStop Color="#E8884A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <Border Classes="marker"><Border Classes="dot"><TextBlock Text="1"/></Border></Border>
                            <Border Classes="marker selected"><Border Classes="dot"><TextBlock Text="2"/></Border></Border>
                            <Border Classes="handle"/>
                        </StackPanel>
                    </Border>
                </Border>
            </ThemeVariantScope>
            <ThemeVariantScope RequestedThemeVariant="Light">
                <Border Padding="20" Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
                    <Border Padding="24" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#3A1F5C" Offset="0"/><GradientStop Color="#1F6FB5" Offset="0.55"/><GradientStop Color="#E8884A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <Border Classes="marker"><Border Classes="dot"><TextBlock Text="1"/></Border></Border>
                            <Border Classes="marker selected"><Border Classes="dot"><TextBlock Text="2"/></Border></Border>
                            <Border Classes="handle"/>
                        </StackPanel>
                    </Border>
                </Border>
            </ThemeVariantScope>
        </StackPanel>
    </Design.PreviewWith>

  <Style Selector="Border.marker">
    <Setter Property="BorderThickness" Value="{DynamicResource MarkerRingThickness}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
    <Setter Property="Cursor" Value="SizeAll"/>
  </Style>
  <Style Selector="Border.marker.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Border.marker > Border.dot">
    <Setter Property="Width" Value="{DynamicResource MarkerSize}"/>
    <Setter Property="Height" Value="{DynamicResource MarkerSize}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource MarkerBorderThickness}"/>
  </Style>
  <Style Selector="Border.marker TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="{DynamicResource FontWeightBold}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.handle">
    <Setter Property="Width" Value="{DynamicResource HandleSize}"/>
    <Setter Property="Height" Value="{DynamicResource HandleSize}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource MarkerBorderThickness}"/>
    <Setter Property="Cursor" Value="SizeWestEast"/>
  </Style>
</Styles>
